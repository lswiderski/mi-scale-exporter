<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MiScaleExporter.MAUI.Views.SettingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:MiScaleExporter.MAUI.Behaviors;assembly=MiScaleExporter.MAUI"
    xmlns:localization="clr-namespace:MiScaleExporter.MAUI.Resources.Localization"
    xmlns:models="clr-namespace:MiScaleExporter.Models;assembly=MiScaleExporter.MAUI"
    x:Name="SettingsRoot"
    Title="{Binding Title}"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="16,20,16,28" Spacing="16">

            <!-- Profile -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource SectionHeaderStyle}" Text="{x:Static localization:AppSnippets.SettingsProfile}" />

                    <Label Style="{StaticResource FieldLabelStyle}" Text="{x:Static localization:AppSnippets.Age}" />
                    <HorizontalStackLayout Spacing="24">
                        <RadioButton
                            GroupName="AgeMode"
                            Content="Enter age manually"
                            IsChecked="{Binding UseBirthDateMode, Converter={StaticResource InvertedBoolConverter}}"
                            VerticalOptions="Center" />
                        <RadioButton
                            GroupName="AgeMode"
                            Content="Use birth date"
                            IsChecked="{Binding UseBirthDateMode}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <StackLayout IsVisible="{Binding UseBirthDateMode, Converter={StaticResource InvertedBoolConverter}}">
                        <Entry
                            Style="{StaticResource FieldEntryStyle}"
                            Keyboard="Numeric"
                            Text="{Binding ManualAge, Mode=TwoWay}">
                            <Entry.Behaviors>
                                <behaviors:NumericIntValidationBehavior />
                            </Entry.Behaviors>
                        </Entry>
                    </StackLayout>

                    <StackLayout IsVisible="{Binding UseBirthDateMode}" Spacing="6">
                        <DatePicker
                            Date="{Binding BirthDate, Mode=TwoWay}"
                            MaximumDate="{Binding MaxBirthDate}"
                            FontSize="Medium"
                            Format="dd/MM/yyyy" />
                        <HorizontalStackLayout Spacing="6">
                            <Label Style="{StaticResource MutedCaptionStyle}" Text="Your age:" VerticalOptions="Center" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="Medium"
                                Text="{Binding Age}"
                                TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}"
                                VerticalOptions="Center" />
                            <Label Style="{StaticResource MutedCaptionStyle}" Text="years old" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </StackLayout>

                    <Label Style="{StaticResource FieldLabelStyle}" Text="{x:Static localization:AppSnippets.Height}" />
                    <Entry
                        Style="{StaticResource FieldEntryStyle}"
                        Keyboard="Numeric"
                        Text="{Binding Height, Mode=TwoWay}">
                        <Entry.Behaviors>
                            <behaviors:NumericIntValidationBehavior />
                        </Entry.Behaviors>
                    </Entry>

                    <Label Style="{StaticResource FieldLabelStyle}" Text="{x:Static localization:AppSnippets.Sex}" />
                    <Border
                        Padding="3"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="3">
                            <Border
                                Grid.Column="0"
                                Style="{StaticResource SegmentItemStyle}"
                                BackgroundColor="{Binding IsFemaleSelected, Converter={StaticResource SegmentColorConverter}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="SexRadioSetToFemale" />
                                </Border.GestureRecognizers>
                                <Label
                                    Text="{x:Static localization:AppSnippets.Female}"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="WordWrap"
                                    TextColor="{Binding IsFemaleSelected, Converter={StaticResource SegmentColorConverter}, ConverterParameter=text}" />
                            </Border>
                            <Border
                                Grid.Column="1"
                                Style="{StaticResource SegmentItemStyle}"
                                BackgroundColor="{Binding IsMaleSelected, Converter={StaticResource SegmentColorConverter}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="SexRadioSetToMale" />
                                </Border.GestureRecognizers>
                                <Label
                                    Text="{x:Static localization:AppSnippets.Male}"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="WordWrap"
                                    TextColor="{Binding IsMaleSelected, Converter={StaticResource SegmentColorConverter}, ConverterParameter=text}" />
                            </Border>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Scale -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource SectionHeaderStyle}" Text="{x:Static localization:AppSnippets.ScaleSettings}" />

                    <Label Style="{StaticResource FieldLabelStyle}" Text="{x:Static localization:AppSnippets.ScaleModel}" />
                    <Border
                        Padding="3"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="3">
                            <Border
                                Grid.Column="0"
                                Style="{StaticResource SegmentItemStyle}"
                                BackgroundColor="{Binding IsMiBodyCompositionScaleSelected, Converter={StaticResource SegmentColorConverter}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="ScaleTypeSetToBodyCompositionScale" />
                                </Border.GestureRecognizers>
                                <Label
                                    Text="{x:Static localization:AppSnippets.MiBodyCompositionScale}"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="WordWrap"
                                    TextColor="{Binding IsMiBodyCompositionScaleSelected, Converter={StaticResource SegmentColorConverter}, ConverterParameter=text}" />
                            </Border>
                            <Border
                                Grid.Column="1"
                                Style="{StaticResource SegmentItemStyle}"
                                BackgroundColor="{Binding IsMiSmartScaleSelected, Converter={StaticResource SegmentColorConverter}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="ScaleTypeSetToMiscale" />
                                </Border.GestureRecognizers>
                                <Label
                                    Text="{x:Static localization:AppSnippets.MiSmartScale}"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="WordWrap"
                                    TextColor="{Binding IsMiSmartScaleSelected, Converter={StaticResource SegmentColorConverter}, ConverterParameter=text}" />
                            </Border>
                            <Border
                                Grid.Column="2"
                                Style="{StaticResource SegmentItemStyle}"
                                BackgroundColor="{Binding IsS400Selected, Converter={StaticResource SegmentColorConverter}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="ScaleTypeSetToS400" />
                                </Border.GestureRecognizers>
                                <Label
                                    Text="Mi Scale S400"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="WordWrap"
                                    TextColor="{Binding IsS400Selected, Converter={StaticResource SegmentColorConverter}, ConverterParameter=text}" />
                            </Border>
                        </Grid>
                    </Border>

                    <Label Style="{StaticResource FieldLabelStyle}" Text="{x:Static localization:AppSnippets.BluetoothAddress}" />
                    <Entry
                        Style="{StaticResource FieldEntryStyle}"
                        Placeholder="00:00:00:00:00:00"
                        Text="{Binding Address, Mode=TwoWay}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label
                            Grid.Column="0"
                            Style="{StaticResource FieldLabelStyle}"
                            VerticalOptions="Center"
                            Text="{x:Static localization:AppSnippets.BleKeyLabel}" />
                        <Label
                            Grid.Column="1"
                            Style="{StaticResource LinkLabelStyle}"
                            VerticalOptions="Center"
                            Text="{x:Static localization:AppSnippets.HowToFindAddress}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GetBLEKeyCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Entry
                        Style="{StaticResource FieldEntryStyle}"
                        Text="{Binding Bindkey, Mode=TwoWay}" />
                </VerticalStackLayout>
            </Border>

            <!-- Garmin -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource SectionHeaderStyle}" Text="{x:Static localization:AppSnippets.GarminSettings}" />

                    <Label Style="{StaticResource FieldLabelStyle}" Text="{x:Static localization:AppSnippets.Email}" />
                    <Entry
                        Style="{StaticResource FieldEntryStyle}"
                        Keyboard="Email"
                        Text="{Binding Email, Mode=TwoWay}" />

                    <Label Style="{StaticResource FieldLabelStyle}" Text="{x:Static localization:AppSnippets.Password}" />
                    <Entry
                        Style="{StaticResource FieldEntryStyle}"
                        IsPassword="True"
                        Text="{Binding Password, Mode=TwoWay}" />

                    <Button
                        Margin="0,4,0,0"
                        Command="{Binding ConnectGarminCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Text="{x:Static localization:AppSnippets.ConnectGarmin}" />

                    <Label
                        IsVisible="{Binding HasGarminStatus}"
                        FontAttributes="Bold"
                        FontSize="14"
                        Text="{Binding GarminStatusText}"
                        TextColor="{Binding GarminStatusColor}" />

                    <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowMfaInput}">
                        <Label Style="{StaticResource FieldLabelStyle}" Text="{x:Static localization:AppSnippets.GarminEnterMfa}" />
                        <Entry
                            Style="{StaticResource FieldEntryStyle}"
                            Keyboard="Numeric"
                            Text="{Binding MfaCode, Mode=TwoWay}" />
                        <Button
                            Command="{Binding VerifyMfaCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Text="{x:Static localization:AppSnippets.VerifyMfaCode}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Preferences -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="4">
                    <Label Style="{StaticResource SectionHeaderStyle}" Text="{x:Static localization:AppSnippets.SettingsPreferences}" />

                    <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                        <Label
                            Grid.Column="0"
                            Style="{StaticResource FieldLabelStyle}"
                            FontAttributes="Bold"
                            LineBreakMode="WordWrap"
                            VerticalOptions="Center"
                            Text="{x:Static localization:AppSnippets.AutoUploadToggle}" />
                        <Switch
                            Grid.Column="1"
                            OnColor="{StaticResource Primary}"
                            IsToggled="{Binding OneClickScanAndUpload, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                        <Label
                            Grid.Column="0"
                            Style="{StaticResource FieldLabelStyle}"
                            VerticalOptions="Center"
                            Text="{x:Static localization:AppSnippets.DisplayWeightInLbs}" />
                        <Switch
                            Grid.Column="1"
                            OnColor="{StaticResource Primary}"
                            IsToggled="{Binding DisplayWeightInLbs, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                        <Label
                            Grid.Column="0"
                            Style="{StaticResource FieldLabelStyle}"
                            VerticalOptions="Center"
                            Text="{x:Static localization:AppSnippets.MuscleMassAsPercentage}" />
                        <Switch
                            Grid.Column="1"
                            OnColor="{StaticResource Primary}"
                            IsToggled="{Binding MuscleMassAsPercentage, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                        <Label
                            Grid.Column="0"
                            Style="{StaticResource FieldLabelStyle}"
                            VerticalOptions="Center"
                            Text="{x:Static localization:AppSnippets.SettingsHideAds}" />
                        <Switch
                            Grid.Column="1"
                            OnColor="{StaticResource Primary}"
                            IsToggled="{Binding HideAds, Mode=TwoWay}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Body Fat Calibration -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource SectionHeaderStyle}" Text="Body Fat Calibration" />

                    <Label
                        Style="{StaticResource MutedCaptionStyle}"
                        Text="Pair saved S400 measurements with trusted reference values. Fewer than three references are stored but do not alter uploads. With enough references, body fat is corrected conservatively and dependent estimates are recomputed." />

                    <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                        <Label
                            Grid.Column="0"
                            Style="{StaticResource FieldLabelStyle}"
                            FontAttributes="Bold"
                            LineBreakMode="WordWrap"
                            VerticalOptions="Center"
                            Text="Apply calibration to measurements" />
                        <Switch
                            Grid.Column="1"
                            OnColor="{StaticResource Primary}"
                            IsToggled="{Binding UseFatCalibration, Mode=TwoWay}" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding CalibrationPoints}">
                        <CollectionView.EmptyView>
                            <Label Style="{StaticResource MutedCaptionStyle}" Text="No calibration points added yet." />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:FatCalibrationPoint">
                                <Grid Padding="0,4" ColumnSpacing="8" ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                    <Label
                                        Grid.Column="0"
                                        Style="{StaticResource FieldLabelStyle}"
                                        Text="{Binding Date, StringFormat='{0:yyyy-MM-dd}'}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        Style="{StaticResource MutedCaptionStyle}"
                                        Text="{Binding ScaleFat, StringFormat='scale {0:0.#}%'}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="2"
                                        Style="{StaticResource MutedCaptionStyle}"
                                        Text="{Binding TrueFat, StringFormat='ref {0:0.#}%'}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="3"
                                        Style="{StaticResource MutedCaptionStyle}"
                                        Text="{Binding Source}"
                                        VerticalOptions="Center" />
                                    <Button
                                        Grid.Column="4"
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        Command="{Binding BindingContext.RemoveCalibrationPointCommand, Source={x:Reference SettingsRoot}}"
                                        CommandParameter="{Binding .}"
                                        FontSize="Small"
                                        Text="✕"
                                        TextColor="#DC2626"
                                        WidthRequest="40" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Style="{StaticResource FieldLabelStyle}" Text="Add a point" />
                    <Picker
                        ItemDisplayBinding="{Binding Display}"
                        ItemsSource="{Binding CalibrationMeasurements}"
                        SelectedItem="{Binding SelectedCalibrationMeasurement, Mode=TwoWay}"
                        Title="Saved S400 measurement" />
                    <Picker
                        ItemsSource="{Binding CalibrationSources}"
                        SelectedItem="{Binding NewPointSource, Mode=TwoWay}"
                        Title="Reference source" />
                    <Entry
                        Style="{StaticResource FieldEntryStyle}"
                        Keyboard="Numeric"
                        Placeholder="Reference fat %"
                        Text="{Binding NewPointTrueFat, Mode=TwoWay}">
                        <Entry.Behaviors>
                            <behaviors:NumericDoubleValidationBehavior />
                        </Entry.Behaviors>
                    </Entry>
                    <Button
                        Margin="0,4,0,0"
                        Command="{Binding AddCalibrationPointCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Text="Add point" />

                    <Label
                        Style="{StaticResource MutedCaptionStyle}"
                        Text="{Binding CalibrationSummary}" />

                    <Button
                        Margin="0,4,0,0"
                        Command="{Binding ExportMeasurementHistoryCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Text="Export saved S400 history" />

                    <Button
                        Margin="0,4,0,0"
                        Command="{Binding ClearMeasurementHistoryCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Text="Clear saved S400 history" />
                </VerticalStackLayout>
            </Border>

            <!-- Advanced (secondary / muted) -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource SectionHeaderStyle}" Text="{x:Static localization:AppSnippets.SettingsAdvanced}" />

                    <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                        <Label
                            Grid.Column="0"
                            Style="{StaticResource MutedCaptionStyle}"
                            VerticalOptions="Center"
                            Text="{x:Static localization:AppSnippets.UseExternalAPI}" />
                        <Switch
                            Grid.Column="1"
                            OnColor="{StaticResource Primary}"
                            IsToggled="{Binding UseExternalAPI, Mode=TwoWay}" />
                    </Grid>
                    <Label Style="{StaticResource MutedCaptionStyle}" Text="{x:Static localization:AppSnippets.AlternateExternalAPIAddress}" />
                    <Entry
                        Style="{StaticResource FieldEntryStyle}"
                        Text="{Binding ApiAddress, Mode=TwoWay}" />

                    <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                        <Label
                            Grid.Column="0"
                            Style="{StaticResource MutedCaptionStyle}"
                            VerticalOptions="Center"
                            Text="{x:Static localization:AppSnippets.UseChinaServer}" />
                        <Switch
                            Grid.Column="1"
                            OnColor="{StaticResource Primary}"
                            IsToggled="{Binding UseChinaServer, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                        <Label
                            Grid.Column="0"
                            Style="{StaticResource MutedCaptionStyle}"
                            VerticalOptions="Center"
                            Text="{x:Static localization:AppSnippets.ShowDebug}" />
                        <Switch
                            Grid.Column="1"
                            OnColor="{StaticResource Primary}"
                            IsToggled="{Binding ShowDebugInfo, Mode=TwoWay}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Reset / Danger -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="12">
                    <Button
                        Command="{Binding ResetTokensCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Text="{x:Static localization:AppSnippets.ClearGarminTokens}" />
                    <Button
                        Command="{Binding ResetCommand}"
                        Style="{StaticResource DestructiveButtonStyle}"
                        Text="{x:Static localization:AppSnippets.ResetToDefault}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
