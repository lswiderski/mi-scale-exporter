<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MiScaleExporter.MAUI.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:MiScaleExporter.MAUI.Resources.Localization"
    xmlns:vm="clr-namespace:MiScaleExporter.MAUI.ViewModels"
    Title="{Binding Title}"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="16,20,16,28" Spacing="16">

            <!-- Hero header -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                        <Label
                            Style="{StaticResource HeroTitleStyle}"
                            Text="{x:Static localization:AppSnippets.MiScaleExporter}" />
                        <Label
                            Style="{StaticResource HeroSubtitleStyle}"
                            Text="{x:Static localization:AppSnippets.OnboardingSubtitle}" />
                    </VerticalStackLayout>
                    <Image
                        Grid.Column="1"
                        HeightRequest="56"
                        WidthRequest="56"
                        VerticalOptions="Center"
                        Source="scale.png" />
                </Grid>
            </Border>

            <!-- Primary CTA -->
            <Button
                Command="{Binding GoToScanCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="{x:Static localization:AppSnippets.MeasureNow}" />

            <!-- Setup status row -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToSettingsCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label
                            FontSize="13"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}"
                            Text="{x:Static localization:AppSnippets.HomeProfile}" />
                        <Label
                            FontSize="18"
                            HorizontalOptions="Center"
                            IsVisible="{Binding ProfileConfigured}"
                            TextColor="{StaticResource StatusStandardColor}"
                            Text="&#x2714;" />
                        <Label
                            HorizontalOptions="Center"
                            Style="{StaticResource MutedCaptionStyle}"
                            Text="{Binding ProfileStatus}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="10,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToSettingsCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label
                            FontSize="13"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}"
                            Text="{x:Static localization:AppSnippets.HomeScale}" />
                        <Label
                            FontSize="18"
                            HorizontalOptions="Center"
                            IsVisible="{Binding ScaleConfigured}"
                            TextColor="{StaticResource StatusStandardColor}"
                            Text="&#x2714;" />
                        <Label
                            HorizontalOptions="Center"
                            Style="{StaticResource MutedCaptionStyle}"
                            Text="{Binding ScaleStatus}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="10,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToSettingsCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label
                            FontSize="13"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}"
                            Text="{x:Static localization:AppSnippets.HomeGarmin}" />
                        <Label
                            FontSize="18"
                            HorizontalOptions="Center"
                            IsVisible="{Binding GarminConfigured}"
                            TextColor="{StaticResource StatusStandardColor}"
                            Text="&#x2714;" />
                        <Label
                            HorizontalOptions="Center"
                            Style="{StaticResource MutedCaptionStyle}"
                            Text="{Binding GarminStatus}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Secondary actions -->
            <Button
                Command="{Binding OpenHelpCommand}"
                Style="{StaticResource SecondaryButtonStyle}"
                Text="{x:Static localization:AppSnippets.OpenHelp}" />
            <Button
                Command="{Binding RerunSetupCommand}"
                Style="{StaticResource SecondaryButtonStyle}"
                Text="{x:Static localization:AppSnippets.ReRunSetup}" />
            <Button
                Command="{Binding OpenGithubCommand}"
                Style="{StaticResource SecondaryButtonStyle}"
                Text="{x:Static localization:AppSnippets.VisitProjectRepository}" />

            <!-- Support -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label
                        Style="{StaticResource MutedCaptionStyle}"
                        Text="{x:Static localization:AppSnippets.DoYouLikeAndWouldYouLikeToSupport}" />
                    <ImageButton
                        Command="{Binding OpenCoffeeCommand}"
                        HeightRequest="50"
                        HorizontalOptions="Start"
                        Source="Images/buymeacoffe.png" />
                </VerticalStackLayout>
            </Border>

            <!-- About this app (secondary) -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label
                        Style="{StaticResource SectionHeaderStyle}"
                        Text="{x:Static localization:AppSnippets.AboutThisApp}" />
                    <Label Style="{StaticResource MutedCaptionStyle}" Text="{x:Static localization:AppSnippets.AboutGarmin}" />
                    <Label Style="{StaticResource MutedCaptionStyle}" Text="{x:Static localization:AppSnippets.AboutMeasureInstruction}" />
                    <Label Style="{StaticResource MutedCaptionStyle}" Text="{x:Static localization:AppSnippets.AboutUpload}" />
                    <Label Style="{StaticResource MutedCaptionStyle}" Text="{x:Static localization:AppSnippets.AboutMFAAndStoringData}" />
                </VerticalStackLayout>
            </Border>

            <!-- AdMob banner injected here in code-behind (Android only, preview-safe) -->
            <VerticalStackLayout x:Name="AdContainer" Spacing="0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
