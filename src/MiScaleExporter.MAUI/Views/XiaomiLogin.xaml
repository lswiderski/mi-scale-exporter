<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MiScaleExporter.MAUI.Views.XiaomiLogin"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        xmlns:admob="clr-namespace:Plugin.AdMob;assembly=Plugin.AdMob"
    Title="Xiaomi Login">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <admob:BannerAd
x:Name="adMobBanner"
AdUnitId="ca-app-pub-1938975042085430/4160336701" 
AdSize="Banner"
 />
            <Label
                Text="Click Get Pass Token first. Then scan the QR code with the Xiaomi Home app, or open the link below in your default browser to sign in to Xiaomi Home."
                FontSize="16"
                HorizontalTextAlignment="Center" />

            <VerticalStackLayout IsVisible="{Binding IsPolling, Converter={StaticResource InvertedBoolConverter}}">
                <Label FontSize="Small" Text="User ID" />
                <Entry
                    FontSize="Medium"
                    Text="{Binding XiaomiUserId, Mode=TwoWay}"
                    Placeholder="Enter User ID" />
                <Label FontSize="Small" Text="Pass Token" />
                <Editor
                    FontSize="Medium"
                    Text="{Binding XiaomiPassToken, Mode=TwoWay}"
                    Placeholder="Enter Pass Token"
                    HeightRequest="100" />
            </VerticalStackLayout>

            <Button
                Text="Get Pass Token"
                Command="{Binding GetPassTokenCommand}"
                IsEnabled="{Binding IsPolling, Converter={StaticResource InvertedBoolConverter}}"
                HorizontalOptions="Fill"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"/>

            <Button
                Text="Restart Login"
                Command="{Binding RestartLoginCommand}"
                IsVisible="{Binding IsPolling}"
                HorizontalOptions="Fill" 
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"/>

            <!-- Status Message -->
            <Label
                Text="{Binding LoginStatus}"
                FontSize="14"
                TextColor="Gray"
                HorizontalTextAlignment="Center" />

            <!-- QR Code Display -->
            <Border
                Stroke="LightGray"
                Padding="5"
                IsVisible="{Binding QrCodeBytes, Converter={StaticResource ByteArrayToVisibilityConverter}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Image
                    x:Name="QrCodeImage"
                    Aspect="AspectFit"
                    WidthRequest="300"
                    HeightRequest="300"
                    HorizontalOptions="Center" />
            </Border>

            <!-- Login URL Link -->
            <Border
                Stroke="LightGray"
                Padding="10"
                IsVisible="{Binding LoginUrl, Converter={StaticResource StringToVisibilityConverter}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="5">
                    <Label
                        Text="Or open this link in your browser:"
                        FontSize="12"
                        TextColor="Gray" />
                    <Label
                        Text="{Binding LoginUrl}"
                        FontSize="14"
                        TextColor="Blue"
                        TextDecorations="Underline"
                        HorizontalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding OpenLoginUrlCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <!-- Loading Indicator during polling -->
            <ActivityIndicator
                IsRunning="{Binding IsPolling}"
                IsVisible="{Binding IsPolling}"
                Color="Blue"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
